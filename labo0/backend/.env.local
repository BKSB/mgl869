# Modele de configuration (valeurs vides) — versionne sur GitHub.
# Copier ce fichier vers .env puis renseigner les valeurs :
#   cp .env.local .env

# Bootstrap server
KAFKA_BOOTSTRAP_SERVERS=
# Security protocol (ex. SASL_SSL)
KAFKA_SECURITY_PROTOCOL=
# SASL mechanism (ex. SCRAM-SHA-512)
KAFKA_SASL_MECHANISM=
# Kafka username
KAFKA_USERNAME=
# Kafka password
KAFKA_PASSWORD=
# CA certificate : chemin sur l'hote (monte en volume par docker-compose)
KAFKA_SSL_CA_HOST_PATH=
# CA certificate : chemin dans le conteneur (cible du montage)
KAFKA_SSL_CA_LOCATION=
# Topics (vide = topics gridd par defaut)
KAFKA_TOPICS=
KAFKA_GROUP_ID_PREFIX=
KAFKA_AUTO_OFFSET_RESET=
OUTPUT_DIR=
# Historique WebSocket par capteur (vide = 100)
HISTORY_PER_SENSOR=
# Prechauffage au demarrage : messages relus par partition (vide = 1000, 0 = off)
WARMUP_MESSAGES=
